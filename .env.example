# ===== OCC-CDP environment (dev) =====
NODE_ENV=development

# --- PostgreSQL 18 (system of record) ---
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=AI_CDP_Pro
PGUSER=occ_cdp
PGPASSWORD=occ_cdp_dev
DATABASE_URL=postgresql://occ_cdp:occ_cdp_dev@127.0.0.1:5433/AI_CDP_Pro

# --- ClickHouse (OLAP/analytics) ---
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DB=occ_cdp
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- Redis (cache / profile API) ---
REDIS_URL=redis://127.0.0.1:6379

# --- MinIO (object storage) ---
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=occ_cdp
MINIO_SECRET_KEY=occ_cdp_dev_secret

# --- Auth (core-api) ---
# Bắt buộc đặt secret mạnh khi production (dev tự dùng secret tạm + cảnh báo).
CORE_API_JWT_SECRET=

# --- Rate-limit (chống burst, in-memory mỗi process) ---
# QUY ƯỚC: để TRỐNG = TẮT. Nếu KHAI BÁO thì phải là SỐ DƯƠNG, sai/0 -> app fail-fast khi khởi động
# (không âm thầm tắt control bảo mật). Đa-instance cần Redis store (chưa có) để thực thi đúng.
#
# 1) Theo PRINCIPAL (đã xác thực) — key theo id ổn định của user/api-key. Khuyến nghị prod vd 600.
RATE_LIMIT_SOURCE_BURST=
RATE_LIMIT_SOURCE_REFILL_PER_SEC=         # token/giây (mặc định = BURST)
# 2) Route PUBLIC (login) — chống brute force/credential stuffing, key theo IP (CHẶT hơn).
#    Bật SOURCE sẽ tự bật PUBLIC mặc định (burst 10, refill 1/giây) nếu để trống.
RATE_LIMIT_PUBLIC_BURST=
RATE_LIMIT_PUBLIC_REFILL_PER_SEC=
# 3) PRE-AUTH theo IP (opt-in) — shed flood trước khi tốn JWT/DB lookup. Coarse-grained;
#    chống flood toàn diện nên đặt thêm ở edge (WAF/nginx limit_req).
RATE_LIMIT_IP_BURST=
RATE_LIMIT_IP_REFILL_PER_SEC=
# Loại bucket idle để chống rò bộ nhớ (mặc định 3600000ms = 1 giờ).
RATE_LIMIT_MAX_IDLE_MS=

# --- Proxy ---
# Để req.ip là IP CLIENT thật khi chạy sau proxy/LB (cần cho rate-limit theo IP).
# Đặt SỐ HOP tin cậy (vd '1' nếu sau 1 proxy strip X-Forwarded-For); tránh 'true' trừ khi
# edge đã strip header (tránh bị giả mạo X-Forwarded-For). Để trống = tắt (dev/không proxy).
TRUST_PROXY=

# --- AI providers (LLM gateway) ---
# Đặt key cho provider muốn dùng; chọn provider/model theo task trong AI Settings (admin).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- ai-service (ML: churn/CLV/propensity/next-purchase) ---
# core-api gọi qua đây; down/timeout -> tự fallback heuristic (circuit-breaker).
AI_SERVICE_URL=http://127.0.0.1:8072

# --- Ports ---
CORE_API_PORT=8071
ADMIN_CONSOLE_PORT=8073
