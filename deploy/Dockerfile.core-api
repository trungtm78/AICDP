# core-api — image chạy bằng tsx (context build = GỐC repo)
FROM node:22-alpine
WORKDIR /app
RUN corepack enable

# Cài deps theo lockfile (chỉ core-api)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY services/core-api/package.json services/core-api/package.json
RUN pnpm install --frozen-lockfile --filter @occ-cdp/core-api

# Mã nguồn + migrations (migrate.ts đọc <repo>/db/migrations)
COPY services/core-api services/core-api
COPY db db

EXPOSE 8071
CMD ["pnpm", "--dir", "services/core-api", "exec", "tsx", "src/main.ts"]
